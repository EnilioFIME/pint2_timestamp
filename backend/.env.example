# Variables requeridas por el backend Spring Boot.
# Copia este archivo a `.env` (no commitear) o exporta las variables
# en el entorno del sistema / configuración del IDE antes de arrancar.

# Credenciales de Azure SQL Server
DB_USERNAME=
DB_PASSWORD=

# Credenciales del admin para HTTP Basic Auth de la API
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
